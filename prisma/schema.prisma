// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum Role {
  user
  admin
}

enum MovementType {
  IN
  OUT
  RETURN_SUPPLIER
  RETURN_CLIENT
}

enum MovementStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum InvoiceType {
  SALE
  CREDIT_NOTE
  PROFORMA
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

// ─────────────────────────────────────────
// Models
// ─────────────────────────────────────────

model Company {
  id               String   @id @default(cuid())
  name             String
  matriculeFiscale String?  // Requis pour la facturation tunisienne
  address          String?
  phone            String?
  created_at       DateTime @default(now())
  is_active        Boolean  @default(true)

  users      User[]
  categories Category[]
  suppliers  Supplier[]
  products   Product[]
  movements  Movement[]
  clients    Client[]
  invoices   Invoice[]
  quotes     Quote[]
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  email           String    @unique
  password        String
  role            Role      @default(user)
  // Code OTP de vérification (4 chiffres)
  code            Int?
  code_expires_at DateTime? // Expiration du code OTP — obligatoire pour la sécurité
  is_active       Boolean   @default(false)
  phone           String?   @unique
  created_at      DateTime  @default(now())
  last_login      DateTime?
  refreshToken    String?   @db.Text

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  movements Movement[]
  clients   Client[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  code        Int
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  products Product[]

  @@unique([name, companyId])
  @@unique([code, companyId])
}

model Supplier {
  id         String   @id @default(cuid())
  name       String
  code       Int?     @unique
  email      String?  @unique
  phone      String   @unique
  address    String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  products  Product[]
  movements Movement[]
}

model Product {
  id             String @id @default(cuid())
  code           Int    @unique
  barcode        Int    @unique
  name           String
  purchase_price Float
  selling_price  Float
  // Quantité en stock (champ de stock actuel)
  stock_quantity Int    @default(0)
  stock_min      Int
  stock_max      Int?

  // TVA tunisienne (obligatoire légalement) : 0, 7, 13, ou 19%
  tva_rate Int @default(19)

  unit_of_measure String @default("pièce") // kg, litre, pièce, etc.

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  movementItems MovementItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Movement {
  id           String         @id @default(cuid())
  type         MovementType
  reference    String?
  note         String?
  status       MovementStatus @default(CONFIRMED)
  // Montant total figé au moment du mouvement (évite les incohérences si les prix changent)
  total_amount Float?
  created_at   DateTime       @default(now())

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  created_by  User   @relation(fields: [createdById], references: [id])
  createdById String

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  items    MovementItem[]
  invoice  Invoice?
}

model MovementItem {
  id         String @id @default(cuid())
  // Quantité déplacée (entrée, sortie, retour...)
  quantity   Int
  unit_price Float

  movement   Movement @relation(fields: [movementId], references: [id])
  movementId String

  product   Product @relation(fields: [productId], references: [id])
  productId String
}

model Client {
  id               String  @id @default(cuid())
  name             String
  phone            String  @unique
  // Matricule fiscale tunisien (chaîne alphanumérique, ex: "0123456A/P/M000")
  matriculeFiscale String  @unique
  // Code TVA : chaîne alphanumérique (pas un Float)
  codeTva          String?
  address          String?
  is_active        Boolean @default(true)

  movements Movement[]

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
  
  invoices Invoice[]
  quotes   Quote[]
}

model Invoice {
  id              String        @id @default(cuid())
  reference       String        @unique
  date            DateTime      @default(now())
  
  invoice_type    InvoiceType   @default(SALE)
  
  // Montants selon la norme tunisienne
  total_ht        Float
  tva_amount      Float
  timbre_fiscal   Float         @default(1.000) // Timbre fiscal tunisien actuel (1 DT)
  total_ttc       Float         // total_ht + tva_amount + timbre_fiscal

  // Régime fiscal tunisien
  is_suspended    Boolean       @default(false)  // Vente en suspension de TVA
  attestation_ref String?                         // N° attestation fiscale suspension TVA
  
  // Retenue à la source tunisienne
  apply_rs        Boolean       @default(false)
  rs_rate         Float         @default(1.0)    // Taux RS: 1.0, 5.0, ou 15.0
  rs_amount       Float         @default(0.0)    // Montant déduit
  net_payable     Float?                         // TTC - RS
  
  // TVA ventilée par taux (JSON)
  tva_breakdown   String?       @db.Text         // JSON: [{rate:7,base_ht:100,tva_amount:7}]
  
  // Référence bon de commande client
  purchase_order_ref String?
  
  // Notes et conditions
  notes           String?       @db.Text
  payment_terms   String?                        // ex: "Paiement 30 jours"
  
  // Pour les avoirs : référence à la facture originale
  original_invoice_id String?
  
  status          InvoiceStatus @default(PENDING)
  
  movement   Movement @relation(fields: [movementId], references: [id])
  movementId String   @unique
  
  client     Client?  @relation(fields: [clientId], references: [id])
  clientId   String?
  
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String
}

model Quote {
  id              String      @id @default(cuid())
  reference       String      @unique
  date            DateTime    @default(now())
  valid_until     DateTime?                      // Date limite de validité
  status          QuoteStatus @default(DRAFT)
  
  // Montants
  total_ht        Float       @default(0)
  tva_amount      Float       @default(0)
  total_ttc       Float       @default(0)
  
  // Régime fiscal
  is_suspended    Boolean     @default(false)
  
  // Notes et conditions
  notes           String?     @db.Text
  payment_terms   String?
  
  // Items du devis (JSON dénormalisé)
  items           String      @db.Text  // JSON: [{productId,name,qty,unit_price,tva_rate}]
  
  // Références
  client          Client?     @relation(fields: [clientId], references: [id])
  clientId        String?
  
  company         Company     @relation(fields: [companyId], references: [id])
  companyId       String
  
  // Si converti en facture
  invoice_id      String?
  
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
}
