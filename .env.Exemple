# Database
DATABASE_URL="mysql://username:password@localhost:5432/database_name"
#Server
PORT=3000

# Session
SESSION_SECRET="your_session_secret_here"
# JWT Authentication (nom exact lu par le code : net_Secret)
net_Secret="your_jwt_secret_here"
REFRESH_TOKEN_SECRET="your_refresh_token_secret_here"

# Access token expiration
ACCESS_TOKEN_EXPIRY="15m"
# Refresh token expiration
REFRESH_TOKEN_EXPIRY="10d"

# Email / SMTP
EmailUser="your_email@example.com"
EmailPassword="your_application_password_here"

# Docker (docker-compose.yml)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=fluxiodb
MYSQL_USER=fluxio
MYSQL_PASSWORD=

# Origines du frontend autorisées (CORS), séparées par des virgules
FRONTEND_URL=http://localhost:5173
